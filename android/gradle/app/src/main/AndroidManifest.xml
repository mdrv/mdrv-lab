<?xml version="1.0" encoding="utf-8" ?>
<!--
  AndroidManifest.xml for mdrv-lab.

  Minimal NativeActivity manifest: loads libmdrv_lab.so (via the
  nativeLibraryName placeholder) and boots the GPUI application from Rust.
  Deeplink / media / picker helpers from the gpui-mobile example are
  intentionally stripped.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Vulkan feature (optional — wgpu falls back to GLES). -->
    <uses-feature
        android:name="android.hardware.vulkan.level"
        android:required="false"
        android:version="0"
    />
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:required="false"
        android:version="0x00401000"
    />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false"
    />

    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/GpuiTheme"
    >

        <activity
            android:name="dev.gpui.mobile.GpuiActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified"
            android:theme="@style/GpuiSplashTheme"
            android:windowSoftInputMode="adjustResize"
        >
            <meta-data
                android:name="android.app.lib_name"
                android:value="${nativeLibraryName}"
            />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
